# -----------------------------------------------------------------------------
# Supabase (optional locally — without these, the app reads content/ JSON)
# Create a free project at https://supabase.com/dashboard → Project Settings → API
#
# These are SERVER-ONLY (no NEXT_PUBLIC_ prefix). Content reads run on the
# server — do not expose them to the browser / Vercel "Config" public vars.
# Legacy NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY still work
# as a temporary fallback.
# -----------------------------------------------------------------------------

# Project URL (Settings → API → Project URL)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon key (Settings → API → Project API keys → anon public)
# Used server-side only; RLS limits it to SELECT on published rows.
SUPABASE_ANON_KEY=your-anon-key

# Service role key (Settings → API → Project API keys → service_role)
# SERVER / SEED ONLY — never commit, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Keystatic GitHub storage (optional — only if you enable GitHub mode in
# keystatic.config.ts for production CMS editing)
# -----------------------------------------------------------------------------
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
