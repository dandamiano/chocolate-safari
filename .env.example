# -----------------------------------------------------------------------------
# Supabase (server-only)
# Create a free project at https://supabase.com/dashboard → Project Settings → API
#
# Prefer these SERVER-ONLY names. Do not use NEXT_PUBLIC_SUPABASE_* for this app;
# Auth (public + admin) runs via server actions + cookies.
# -----------------------------------------------------------------------------

# Project URL (Settings → API → Project URL)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon / publishable key (Settings → API → Project API keys)
# Used server-side for public reads, public Auth, and admin Auth (RLS still applies).
SUPABASE_ANON_KEY=your-anon-key

# Service role key (Settings → API → Project API keys → service_role)
# SERVER / SEED / ADMIN WRITES ONLY — never commit, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed into /admin (in addition to
# user_metadata.role === "admin" on the Auth user).
ADMIN_EMAILS=you@example.com

# -----------------------------------------------------------------------------
# AI Sommelier (optional)
# When set, POST /api/sommelier calls an OpenAI-compatible chat API with
# catalogue context. Without a key, canned/tag replies are used (site still works).
# Never use NEXT_PUBLIC_* for API keys.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# Or a generic OpenAI-compatible provider:
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Keystatic GitHub storage (optional — only if you enable GitHub mode in
# keystatic.config.ts for production CMS editing)
# -----------------------------------------------------------------------------
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
